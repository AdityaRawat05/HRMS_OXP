/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model attendance_records {
  id                    BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  employee_id           Int                       @db.UnsignedInt
  attendance_date       DateTime                  @db.Date
  check_in              DateTime                  @db.DateTime(0)
  check_out             DateTime?                 @db.DateTime(0)
  worked_hours          Decimal?                  @db.Decimal(5, 2)
  overtime_hours        Decimal                   @default(0.00) @db.Decimal(5, 2)
  break_hours           Decimal                   @default(0.00) @db.Decimal(4, 2)
  status                attendance_records_status @default(present)
  is_late               Boolean                   @default(false)
  late_minutes          Int                       @default(0) @db.UnsignedSmallInt
  is_early_leave        Boolean                   @default(false)
  is_manually_corrected Boolean                   @default(false)
  corrected_by          Int?                      @db.UnsignedInt
  correction_reason     String?                   @db.VarChar(500)
  source                attendance_records_source @default(web)
  created_at            DateTime                  @default(now()) @db.DateTime(0)
  updated_at            DateTime                  @default(now()) @db.DateTime(0)
  employees             employees                 @relation(fields: [employee_id], references: [id], map: "fk_attendance_employee")

  @@unique([employee_id, attendance_date], map: "uk_attendance_employee_date")
  @@index([attendance_date], map: "idx_attendance_date")
  @@index([attendance_date, status], map: "idx_attendance_date_status")
  @@index([employee_id, status, attendance_date], map: "idx_attendance_employee_status")
  @@index([status, check_out], map: "idx_attendance_missing_checkout")
  @@index([employee_id, attendance_date, worked_hours, overtime_hours, status], map: "idx_attendance_payroll")
  @@index([status], map: "idx_attendance_status")
}

